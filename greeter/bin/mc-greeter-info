#!/usr/bin/env python3
"""LightDM greeter-setup-script for the Minecraft login theme.

Writes this computer's info (shown on the "Minecraft Realms" screen) and the configured keyboard layouts
(cycled by the language button) to the theme's js/greeter-info.js, then keeps it fresh in the background
while the login screen is up. It must never fail or block: LightDM would not start the greeter.
  --once   write the file and exit (used by the installer)
"""
import json, os, socket, subprocess, sys, time

OUT = "/usr/share/web-greeter/themes/minecraft/js/greeter-info.js"
ENV = dict(os.environ, LC_ALL="C")
PERIOD = 5          # seconds between refreshes
MAX_TIME = 3600     # stop refreshing after an hour at the login screen


def run(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=3, env=ENV).stdout
    except Exception:
        return ""


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def keyboard_layouts():
    """LightDM layout names ("fr\tazerty", "us") from /etc/default/keyboard, plus "us" as a fallback."""
    conf = {}
    for line in read("/etc/default/keyboard").splitlines():
        k, _, v = line.strip().partition("=")
        conf[k] = v.strip().strip('"')
    layouts = [l for l in conf.get("XKBLAYOUT", "").split(",") if l]
    variants = conf.get("XKBVARIANT", "").split(",")
    out = [l + ("\t" + variants[i] if i < len(variants) and variants[i] else "") for i, l in enumerate(layouts)]
    if "us" not in layouts:
        out.append("us")
    return out


def info():
    os_name = "Linux"
    for line in read("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            os_name = line.split("=", 1)[1].strip().strip('"')
    ip = (run(["hostname", "-I"]).split() or [""])[0]
    net = ""
    for line in run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]).splitlines():
        name, _, kind = line.rpartition(":")
        if name and kind != "loopback":
            net = name.replace("\\:", ":")
            break
    battery = None
    base = "/sys/class/power_supply"
    for n in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        if n.startswith("BAT") and read(os.path.join(base, n, "capacity")).isdigit():
            battery = {"pct": int(read(os.path.join(base, n, "capacity"))), "status": read(os.path.join(base, n, "status"))}
            break
    try:
        boot = int(time.time() - float(read("/proc/uptime").split()[0]))
    except (IndexError, ValueError):
        boot = 0
    return {"host": socket.gethostname(), "os": os_name, "kernel": os.uname().release, "ip": ip, "net": net,
            "battery": battery, "boot": boot, "layouts": keyboard_layouts()}


def write():
    try:
        tmp = OUT + ".tmp"
        with open(tmp, "w") as f:
            f.write("window.MC_INFO = %s;\n" % json.dumps(info()))
        os.chmod(tmp, 0o644)
        os.replace(tmp, OUT)
    except Exception:
        pass


def greeter_running():
    return run(["pgrep", "-f", "nody-greeter"]).strip() != ""


def main():
    write()
    if "--once" in sys.argv:
        return
    if os.fork() > 0:                    # LightDM waits for this process only: return right away
        return
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    start = time.time()
    while time.time() - start < MAX_TIME:
        time.sleep(PERIOD)
        if time.time() - start > 30 and not greeter_running():   # 30 s grace while the greeter starts
            break
        write()
    os._exit(0)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
